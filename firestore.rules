rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. 개인화 링크 목록 (11주차 & 12주차: 조회는 누구나, 수정은 본인만)
    match /users/{userId}/links/{linkId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. 프로필 정보 (12주차: 조회는 누구나, 수정은 본인만)
    match /users/{userId}/profile/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 3. 사용자 기본 문서 (users/{userId})
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 4. username 검색 및 매핑 컬렉션 (조회는 누구나, 생성/수정은 인증된 사용자)
    match /usernames/{username} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
